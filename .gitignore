# Go
/bin/
*.exe
*.test
*.out

# Node
node_modules/
dist/
# …except the directory the binary embeds. //go:embed fails to compile when
# its target is missing, so this one has to exist in a fresh clone even though
# everything the frontend build puts in it is ignored. The directory has to be
# un-ignored before anything inside it can be: git does not descend into an
# excluded directory, so a negation nested under one never applies.
!internal/webui/dist/
!internal/webui/dist/.gitkeep
!internal/webui/dist/.gitignore
.vite/
# Local
*.local
.env
# Machine-local make settings: the database URLs for the engines the suite
# runs against. Ignored because the ports are whoever's containers these are.
local.mk
# Everything "make demo" writes: the database it seeds, the scanner's
# vulnerability cache, and the proxy configuration it generates. In the tree so
# that deleting the checkout deletes the state, rather than leaving something
# behind in somebody's home directory.
.demo/
.DS_Store
# Docs build
/site/
# Build output
#
# Every package here is run with "go run", so a binary in the tree came from
# somebody typing "go build" instead — and two of them were committed, three
# and a half megabytes each, because nothing here said not to. Named one by
# one rather than by a pattern: these are the names "go build" gives a package
# at the root of the checkout, and a pattern matching them would also match a
# directory somebody means to keep.
/openpsirt
/attached
/compose
/confined
/engines
/gate
/granted
/negatives
/readable
/reserved
/unclaimed
/unreachable
/walk
