  "streams": { "path": "/products/:product/streams" },
  "stream": { "path": "/products/:product/streams/:stream" },
  "variants": { "path": "/products/:product/variants" },
  "productFindings": {
    "path": "/products/:product/findings",
    "query": [
      "assigned",
      "below",
      "beneath",
      "beneath_ecosystem",
      "beneath_namespace",
      "beneath_version",
      "component",
      "decision",
      "decision_state",
      "exploited",
      "fixable",
      "on",
      "open_for",
      "open_under",
      "opened_by_run",
      "origin",
      "planned",
      "q",
      "running",
      "state",
      "stream",
      "support",
      "variant"
    ]
  },
  "productComponent": {
    "path": "/products/:product/components/:component",
    "query": ["stream", "variant", "version"]
  },
  "buildFindings": {
    "path": "/products/:product/streams/:stream/variants/:variant/findings",
    "query": [
      "assigned",
      "below",
      "beneath",
      "beneath_ecosystem",
      "beneath_namespace",
      "beneath_version",
      "component",
      "decision",
      "decision_state",
      "exploited",
      "fixable",
      "on",
      "open_for",
      "open_under",
      "opened_by_run",
      "origin",
      "planned",
      "q",
      "running",
      "state",
      "stream",
      "support",
      "variant"
    ]
  },
  "finding": {
    "path": "/products/:product/streams/:stream/variants/:variant/findings/:vulnerability/components/:component",
    "query": ["ecosystem", "from", "namespace", "rule", "version"]
  },
  "dependencies": {
    "path": "/products/:product/streams/:stream/variants/:variant/dependencies",
    "query": ["at", "ecosystem", "namespace", "path", "q", "version"]
  },
  "bulkDecision": {
    "path": "/products/:product/streams/:stream/variants/:variant/components/:component/bulk-decision",
    "query": ["contains", "ecosystem", "namespace", "version"]
  },
  "uploads": { "path": "/products/:product/streams/:stream/variants/:variant/uploads" },
  "uploadsOf": { "path": "/products/:product/streams/:stream/variants/:variant/uploads/:type" },
  "inventoryChanges": {
    "path": "/products/:product/streams/:stream/variants/:variant/uploads/:scan/changes"
  },
  "run": { "path": "/products/:product/streams/:stream/variants/:variant/runs/:run" },
  "upgrades": { "path": "/products/:product/streams/:stream/variants/:variant/pending-upgrades" },
