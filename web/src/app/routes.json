{
  "home": { "path": "/" },
  "reviewQueue": {
    "path": "/review-queue",
    "query": ["mine", "own", "product", "reaffirm", "reason"]
  },
  "unassigned": { "path": "/unassigned" },
  "findings": {
    "path": "/findings",
    "query": [
      "assigned",
      "below",
      "beneath",
      "beneath_ecosystem",
      "beneath_namespace",
      "beneath_version",
      "claim",
      "claim_state",
      "component",
      "exploited",
      "fixable",
      "on",
      "open_for",
      "open_under",
      "opened_by_run",
      "origin",
      "planned",
      "q",
      "running",
      "state",
      "stream",
      "support",
      "variant"
    ]
  },
  "claim": { "path": "/claims/:id" },
  "decision": { "path": "/decisions/:id" },
  "issue": { "path": "/issues/:vulnerability" },
  "products": { "path": "/products" },
  "product": { "path": "/products/:product" },
  "streams": { "path": "/products/:product/streams" },
  "stream": { "path": "/products/:product/streams/:stream" },
  "variants": { "path": "/products/:product/variants" },
  "productFindings": {
    "path": "/products/:product/findings",
    "query": [
      "assigned",
      "below",
      "beneath",
      "beneath_ecosystem",
      "beneath_namespace",
      "beneath_version",
      "claim",
      "claim_state",
      "component",
      "exploited",
      "fixable",
      "on",
      "open_for",
      "open_under",
      "opened_by_run",
      "origin",
      "planned",
      "q",
      "running",
      "state",
      "stream",
      "support",
      "variant"
    ]
  },
  "productComponent": {
    "path": "/products/:product/components/:component",
    "query": ["stream", "variant", "version"]
  },
  "buildFindings": {
    "path": "/products/:product/streams/:stream/variants/:variant/findings",
    "query": [
      "assigned",
      "below",
      "beneath",
      "beneath_ecosystem",
      "beneath_namespace",
      "beneath_version",
      "claim",
      "claim_state",
      "component",
      "exploited",
      "fixable",
      "on",
      "open_for",
      "open_under",
      "opened_by_run",
      "origin",
      "planned",
      "q",
      "running",
      "state",
      "stream",
      "support",
      "variant"
    ]
  },
  "finding": {
    "path": "/products/:product/streams/:stream/variants/:variant/findings/:vulnerability/components/:component",
    "query": ["ecosystem", "from", "namespace", "rule", "version"]
  },
  "dependencies": {
    "path": "/products/:product/streams/:stream/variants/:variant/dependencies",
    "query": ["at", "ecosystem", "namespace", "path", "q", "version"]
  },
  "decide": {
    "path": "/products/:product/streams/:stream/variants/:variant/components/:component/decide",
    "query": ["contains", "ecosystem", "namespace", "version"]
  },
  "inventories": { "path": "/products/:product/streams/:stream/variants/:variant/inventories" },
  "inventoryChanges": {
    "path": "/products/:product/streams/:stream/variants/:variant/inventories/:scan/changes"
  },
  "run": { "path": "/products/:product/streams/:stream/variants/:variant/runs/:run" },
  "upgrades": { "path": "/products/:product/streams/:stream/variants/:variant/pending-upgrades" },
  "matchCoverage": {
    "path": "/products/:product/streams/:stream/variants/:variant/match-coverage"
  },
  "vex": { "path": "/products/:product/streams/:stream/variants/:variant/vex" },
  "comparison": {
    "path": "/products/:product/comparison",
    "query": ["from", "from_variant", "to", "to_variant", "undisclosed"]
  },
  "inventoryComparison": {
    "path": "/products/:product/comparison/inventory",
    "query": ["change", "from", "from_variant", "to", "to_variant"]
  },
  "inbox": { "path": "/products/:product/inbox", "query": ["waiting"] },
  "inboxReport": { "path": "/products/:product/inbox/:reference" },
  "me": { "path": "/me" },
  "access": { "path": "/access" },
  "person": { "path": "/access/:identity" },
  "teams": { "path": "/teams" },
  "assignments": { "path": "/assignments", "query": ["person", "tab", "team"] },
  "record": {
    "path": "/record",
    "query": ["alone", "from", "in_force", "outcome", "product", "to"]
  },
  "reports": { "path": "/reports" },
  "report": { "path": "/reports/:report", "query": ["days"] },
  "reportFlaw": { "path": "/report-a-flaw", "query": ["from", "product", "source"] },
  "disclosing": { "path": "/disclosing" },
  "exploited": { "path": "/exploited-here", "query": ["product"] },
  "advisories": { "path": "/advisories" },
  "advisory": { "path": "/advisories/:advisory" },
  "autoAssignment": { "path": "/auto-assignment" },
  "settings": { "path": "/settings" },
  "settingsSection": { "path": "/settings/:section" },
  "system": { "path": "/system" },
  "formerAccess": { "path": "/people" },
  "formerPerson": { "path": "/people/:identity" },
  "formerAssignments": { "path": "/work" },
  "formerExploited": { "path": "/obligations" },
  "formerRecord": { "path": "/audit" },
  "formerDependencies": {
    "path": "/products/:product/streams/:stream/variants/:variant/components"
  },
  "formerInventories": { "path": "/products/:product/streams/:stream/variants/:variant/scans" },
  "formerInventoryChanges": {
    "path": "/products/:product/streams/:stream/variants/:variant/scans/:scan/changes"
  }
}
