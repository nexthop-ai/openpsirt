      "origin",
      "planned",
      "q",
      "running",
      "state",
      "stream",
      "support",
      "variant"
    ]
  },
  "decision": { "path": "/decisions/:id" },
  "decisionOccurrence": { "path": "/decision-occurrences/:id" },
  "issue": { "path": "/issues/:vulnerability" },
  "products": { "path": "/products" },
