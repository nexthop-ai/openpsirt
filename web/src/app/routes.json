    "path": "/review-queue",
    "query": ["mine", "own", "product", "reaffirm", "reason"]
  },
  "unassigned": { "path": "/unassigned" },
  "findings": {
    "path": "/findings",
    "query": [
      "assigned",
      "below",
      "beneath",
      "beneath_ecosystem",
      "beneath_namespace",
      "beneath_version",
      "component",
      "decision",
      "decision_state",
      "exploited",
      "fixable",
      "on",
