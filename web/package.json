{
  "name": "openpsirt-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "api": "openapi-typescript ../docs/reference/openapi.yaml -o src/api/schema.d.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "classes": "node scripts/class-collisions.mjs",
    "tokens": "node scripts/tokens.mjs",
    "ladder": "node scripts/one-ladder.mjs",
    "copy": "node scripts/screen-copy.mjs",
    "licenses": "node scripts/licenses.mjs",
    "lint": "eslint . && node scripts/silent-reads.mjs",
    "stylelint": "stylelint \"src/**/*.css\"",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{mjs,ts}\""
  },
  "dependencies": {
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@tanstack/react-query": "5.104.2",
    "dompurify": "3.4.17",
    "markdown-it": "15.0.2",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/markdown-it": "14.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
